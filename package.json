{
  "name": "graphql-starred-repositories",
  "private": true,
  "scripts": {
    "build": "parcel build index.html",
    "start": "parcel index.html --open",
    "lint": "yarn eslint",
    "format": "yarn eslint --fix && yarn stylelint --fix && yarn prettier --write",
    "eslint": "eslint --cache './**/*.{ts,tsx}'",
    "prettier": "prettier './**/*.{md,js,ts,tsx,json}'",
    "stylelint": "stylelint --cache --syntax css-in-js './src/**/*.{ts,tsx}'",
    "graphql-codegen": "graphql-codegen --config codegen.yml --require dotenv/config",
    "postinstall": "yarn graphql-codegen"
  },
  "dependencies": {
    "graphql-tag": "2.10.1",
    "lens.ts": "https://github.com/tbo/lens.ts#master",
    "react": "16.12.0",
    "react-dom": "16.12.0",
    "urql": "1.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.0",
    "@graphql-codegen/fragment-matcher": "7.1.0",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@graphql-codegen/typescript-urql": "5.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.20.0",
    "eslint-plugin-jsx-a11y": "6.2.3",
    "eslint-plugin-react": "7.18.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "graphql": "17.0.2",
    "npm-run-all": "4.1.5",
    "parcel-bundler": "1.12.4",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2"
  }
}
